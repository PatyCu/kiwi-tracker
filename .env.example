# Supabase connection for the app. Copy to .env.local (git-ignored) and restart Expo.
# These defaults point at the local stack; `supabase status` prints the same values.
# Never put a secret key here: EXPO_PUBLIC_* values are bundled into the app.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
