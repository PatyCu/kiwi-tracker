{
  "expo": {
    "name": "Kiwi Tracker",
    "slug": "kiwi-tracker",
    "scheme": "kiwitracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "web": { "bundler": "metro" },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        { "photosPermission": "Allow Kiwi Tracker to choose a photo for your pet." }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
